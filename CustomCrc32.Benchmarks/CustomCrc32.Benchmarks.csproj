<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Single-targeted, unlike the library and the tests, which build for net8.0 as well. The
      System.IO.Hashing comparison needs net10.0 - the package ships its vectorised
      implementation no lower, and a net8.0 consumer silently resolves the netstandard2.0
      asset, which has no intrinsics at all - and there is no value in running the rest twice.
      One framework also means `dotnet run` needs no -f, and every table in the README is
      quoted against the same runtime rather than two.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!--
      Pre-release, because the configurable parameter set this compares against is new in 11.0
      and has not shipped in a stable version yet.
    -->
    <PackageReference Include="System.IO.Hashing" Version="11.0.0-preview.7.26381.103" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CustomCrc32\CustomCrc32.csproj" />
  </ItemGroup>

</Project>
