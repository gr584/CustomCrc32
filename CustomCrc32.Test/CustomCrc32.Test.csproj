<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      System.IO.Hashing 11.0 declares net10.0 as its lowest supported target and warns when
      referenced from net8.0, where NuGet resolves its netstandard2.0 asset instead. That asset
      is wanted here rather than merely tolerated - see the package reference below - and it is
      not taken on trust: Preset_SystemIoHashing_OverCheckString_ReturnsPublishedCheckValue
      anchors it against the twelve published check values on this exact target framework, so
      an unsupported configuration that stopped working would fail the suite rather than
      quietly weaken an oracle.
    -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <!--
      A second oracle, independent of the reference model in the fixture. Pre-release because
      the configurable parameter set it is used for is new in 11.0. Deliberately left to
      resolve its netstandard2.0 asset on this net8.0 target: that build carries no hardware
      intrinsics, so it checks this library's fold against an implementation that does not
      fold. The net10.0 asset, which does, is exercised by the benchmark project instead.
    -->
    <PackageReference Include="System.IO.Hashing" Version="11.0.0-preview.7.26381.103" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CustomCrc32\CustomCrc32.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
